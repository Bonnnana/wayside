# Copy to secrets.properties (git-ignored) and fill in.
#
# A Maps SDK for Android key from the Google Cloud console. Restrict it to the com.wayside
# package plus your debug signing certificate's SHA-1 before using it — an unrestricted key
# lifted from the APK can be spent by anyone.
#
#   ./gradlew signingReport     prints the debug SHA-1
#
# Without this the app still builds; the map just renders blank.
MAPS_API_KEY=
